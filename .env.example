# Copie para .env (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.

# ── Banco (casa com o docker-compose.yml) ──
DATABASE_URL="postgresql://escala:escala@localhost:5432/escala?schema=public"

# ── Better Auth ──
# Gere um segredo (mín. 32 caracteres) com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# URL pública do app. Em produção (VPS), use o domínio https.
BETTER_AUTH_URL="http://localhost:3000"

# ── Google OAuth ──
# console.cloud.google.com → APIs e serviços → Credenciais → Criar credenciais → ID do cliente OAuth (Aplicativo da Web)
#   Origem JavaScript autorizada:   http://localhost:3000
#   URI de redirecionamento:        http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
